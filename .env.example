# Copy to .env (never commit it). Every secret is read from the environment only.

# Teacher LLM (Anthropic). Falls back to ANTHROPIC_API_KEY / `ant auth login` when unset.
TEACHER_API_KEY=

# Hugging Face token for gated base models (hf backend only).
HF_TOKEN=

# Hard cap on teacher spend for a run, in USD. The lower of this and the spec's
# task.teacher_budget_usd wins.
FACTORY_BUDGET_USD=300

# Where projects, runs and the model registry live.
FACTORY_WORKSPACE=workspace

# Spec used by `dagster dev` (pipeline UI).
FACTORY_SPEC=examples/maintenance.yaml

# Optional: require `Authorization: Bearer <token>` on the REST API.
FACTORY_API_TOKEN=

# Optional: llama.cpp checkout (for convert_hf_to_gguf.py and llama-quantize).
LLAMA_CPP_DIR=

# Optional: log runs to MLflow (needs the `tracking` extra).
MLFLOW_TRACKING_URI=

# Emit JSON logs instead of the console renderer.
FACTORY_LOG_JSON=0
